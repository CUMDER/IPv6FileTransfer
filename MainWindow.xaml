<Window x:Class="IPv6FileTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPv6 文件传输" Height="600" Width="900"
		Icon="/icon.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
	<Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 模式选择 -->
		<StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,22,10">
			<RadioButton x:Name="rbSend" Content="发送模式" IsChecked="True" Margin="0,0,20,0"/>
			<RadioButton x:Name="rbReceive" Content="接收模式"/>
			<TextBlock Text="目标 IPv6 地址:" VerticalAlignment="Center" Margin="20,0,5,0"/>
			<TextBox x:Name="txtTargetIP" Width="Auto" MinWidth="80" Text="::1" IsEnabled="{Binding IsChecked, ElementName=rbSend}"/>
			<TextBlock Text="端口:" VerticalAlignment="Center" Margin="10,0,5,0"/>
			<TextBox x:Name="txtPort" Width="Auto" MinWidth="60" Text="9000"/>
		</StackPanel>

		<!-- 拖放区域 -->
		<Border Background="#F0F0F0" BorderBrush="#999" BorderThickness="2" 
                CornerRadius="5" AllowDrop="True" Drop="Window_Drop" Margin="0,27,0,80" Grid.RowSpan="3">
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
				<TextBlock Text="拖拽文件或文件夹到此处" FontSize="24" Foreground="#666"/>
				<TextBlock Text="文件夹将自动打包结构传输" FontSize="14" Foreground="#999" Margin="0,10,0,0"/>
				<ListBox x:Name="lstFiles" Width="Auto" Height="Auto" MinWidth="700" MinHeight="300" Margin="0,20,0,0" 
                         Visibility="Collapsed"/>
			</StackPanel>
		</Border>

		<!-- 进度和控制 -->
		<StackPanel Grid.Row="2" Margin="0,10,0,0">
			<ProgressBar x:Name="progressBar" Height="25" Minimum="0" Maximum="100"/>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
				<Button x:Name="btnStart" Content="开    始" Width="100" Height="35" 
                        Click="btnStart_Click" Background="#007ACC" Foreground="White"/>
				<Button x:Name="btnCancel" Content="清空" Width="80" Height="35" 
                        Margin="10,0,0,0" Click="btnCancel_Click"/>
			</StackPanel>
		</StackPanel>
	</Grid>
</Window>
